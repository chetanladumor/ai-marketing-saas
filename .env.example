# AI Marketing Automation SaaS Configuration

# Port & Environment
PORT=4000
NODE_ENV=development

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_marketing_saas

# Redis
REDIS_URL=redis://localhost:6379

# Local AI Models (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_COMPLETION_MODEL=llama3.1:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Cloud AI Model Providers (Optional / Fallback)
# Leave blank to run 100% on local Ollama ($0 cost)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Default Model Mode: LOCAL_ONLY | COST_SAVER_HYBRID | MAX_PERFORMANCE
DEFAULT_MODEL_MODE=COST_SAVER_HYBRID
